+#ifndef AUDIO_SILENCE_ENCODER_TASK_QUEUE_H_
+#define AUDIO_SILENCE_ENCODER_TASK_QUEUE_H_
+
+#include <algorithm>
+#include <array>
+#include <cstddef>
+#include <cstdint>
+#include <memory>
+#include <utility>
+
+#include "absl/functional/any_invocable.h"
+#include "api/audio/audio_frame.h"
+#include "api/task_queue/task_queue_base.h"
+#include "rtc_base/synchronization/mutex.h"
+#include "system_wrappers/include/clock.h"
+
+namespace webrtc {
+namespace voe {
+
+// Coalesces only known-zero input within a codec-owned packet boundary. The
+// owner must delete/join the borrowed task queue before destroying this object.
+// Handlers borrow their owner; neither the tasks nor callbacks retain it.
+class SilenceEncoderTaskQueue {
+ public:
+  using FrameHandler =
+      absl::AnyInvocable<void(std::unique_ptr<AudioFrame>, Timestamp)>;
+  using WorkBudget = absl::AnyInvocable<size_t()>;
+
+  SilenceEncoderTaskQueue(TaskQueueBase* queue,
+                          Clock* clock,
+                          FrameHandler handler,
+                          WorkBudget budget)
+      : queue_(queue),
+        clock_(clock),
+        handler_(std::move(handler)),
+        budget_(std::move(budget)) {}
+
+  // Frames retain their existing media timestamps and must be submitted in
+  // capture order. At most one frame is retained outside the native task queue.
+  void PostFrame(std::unique_ptr<AudioFrame> frame, bool known_zero) {
+    MutexLock lock(&mutex_);
+    if (known_zero && !pending_ && defer_frames_ > 1) {
+      pending_ = std::move(frame);
+      return;
+    }
+    Frames frames{std::move(pending_), std::move(frame)};
+    PostLocked(std::move(frames), nullptr, known_zero && query_silence_budget_);
+  }
+
+  // A control is submitted atomically after all earlier deferred input. This
+  // also serves as a flush barrier for synchronous configuration and teardown.
+  void PostTask(absl::AnyInvocable<void() &&> task) {
+    MutexLock lock(&mutex_);
+    query_silence_budget_ = true;
+    PostLocked(Frames{std::move(pending_), nullptr}, std::move(task), true);
+  }
+
+ private:
+  using Frames = std::array<std::unique_ptr<AudioFrame>, 2>;
+
+  void PostLocked(Frames frames,
+                  absl::AnyInvocable<void() &&> task,
+                  bool query_budget) RTC_EXCLUSIVE_LOCKS_REQUIRED(mutex_) {
+    const uint64_t generation = ++generation_;
+    // A newer task may change the encoder before another capture arrives.
+    // Do not publish a stale budget from an older in-flight task.
+    defer_frames_ = 1;
+    const Timestamp queued_at = clock_->CurrentTime();
+    queue_->PostTask([this, queued_at, frames = std::move(frames),
+                      task = std::move(task), generation,
+                      query_budget]() mutable {
+      for (auto& frame : frames) {
+        if (frame) {
+          handler_(std::move(frame), queued_at);
+        }
+      }
+      if (task) {
+        std::move(task)();
+      }
+      if (!query_budget) {
+        return;
+      }
+      const size_t next_budget = budget_();
+      MutexLock lock(&mutex_);
+      if (generation == generation_ && !pending_) {
+        query_silence_budget_ = next_budget != 0;
+        defer_frames_ = std::clamp<size_t>(next_budget, 1, 2);
+      }
+    });
+  }
+
+  TaskQueueBase* const queue_;
+  Clock* const clock_;
+  FrameHandler handler_;
+  WorkBudget budget_;
+  Mutex mutex_;
+  std::unique_ptr<AudioFrame> pending_ RTC_GUARDED_BY(mutex_);
+  uint64_t generation_ RTC_GUARDED_BY(mutex_) = 0;
+  size_t defer_frames_ RTC_GUARDED_BY(mutex_) = 1;
+  bool query_silence_budget_ RTC_GUARDED_BY(mutex_) = true;
+};
+
+}  // namespace voe
+}  // namespace webrtc
+
+#endif  // AUDIO_SILENCE_ENCODER_TASK_QUEUE_H_
