+    // RtpStreamConfig. g++ accepts it; clang does not.
+    auto& stream_config_rtx =
+        stream_config.rtx.emplace(RtpStreamConfig::Rtx{});
     stream_config_rtx.ssrc = rtx.ssrcs[index];
     stream_config_rtx.payload_type = rtx.payload_type;
   }
